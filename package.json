{
  "name": "velvarr",
  "version": "0.41.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 6699",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 6699",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/setup.ts --test --test-concurrency=4 tests/*.test.ts",
    "test:mutation": "stryker run",
    "test:mutation:delta": "node scripts/mutation-delta.mjs",
    "setup": "node scripts/setup.mjs",
    "backup": "node scripts/backup.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,tsx,json,mjs}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,tsx,json,mjs}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "qs": "6.16.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/tap-runner": "10.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
